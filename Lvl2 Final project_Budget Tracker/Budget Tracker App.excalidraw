      ],
      "updated": 1791242747689,
      "link": null,
      "locked": false,
      "text": "Filter by date\nentries.date.slice(0,4) for Year\nentries.date.slice(5,7) month\n\n\nconst chooseMonth = \"08\";\n\nconst monthlyExpesnses = entires.fileter(function (entry){\nconst entryMonth = entry.slice(5, 7)\nreturn entry.type === \"expense && entryMonth === selectedMonth\n})\n\n<select id=\"monthFilter\">\n \n  <option value=\"08\">August</option>\n\n</select>",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Filter by date\nentries.date.slice(0,4) for Year\nentries.date.slice(5,7) month\n\n\nconst chooseMonth = \"08\";\n\nconst monthlyExpesnses = entires.fileter(function (entry){\nconst entryMonth = entry.slice(5, 7)\nreturn entry.type === \"expense && entryMonth === selectedMonth\n})\n\n<select id=\"monthFilter\">\n \n  <option value=\"08\">August</option>\n\n</select>",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
