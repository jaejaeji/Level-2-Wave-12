    {
      "id": "1a5ntFw270p7Dts3I_AZd",
      "type": "text",
      "x": 964.8530474354027,
      "y": -15238.238759924485,
      "width": 853.5988159179688,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5W",
      "roundness": null,
      "seed": 946214669,
      "version": 892,
      "versionNonce": 1446896132,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791166107873,
      "link": null,
      "locked": false,
      "text": "Features:\n1. Add income and expense entries\n2. Entries input as objects {id, type, category, amount, description, date}\n3. Store entries array in localStorage\n4. Categorize expenses (Food, Bills, Transport, etc.)\n5. Filter by category - .filter()\n6. Calculate and display total balance, total income, total expenses - .reduce() on entries array\n7. Render transaction list to the DOM - use .forEach() to build each row with createElement;\n8. Re-render list after every add or delete\n9. Contact form - validate and store messages in localStorage\n10. Responsive layout",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Features:\n1. Add income and expense entries\n2. Entries input as objects {id, type, category, amount, description, date}\n3. Store entries array in localStorage\n4. Categorize expenses (Food, Bills, Transport, etc.)\n5. Filter by category - .filter()\n6. Calculate and display total balance, total income, total expenses - .reduce() on entries array\n7. Render transaction list to the DOM - use .forEach() to build each row with createElement;\n8. Re-render list after every add or delete\n9. Contact form - validate and store messages in localStorage\n10. Responsive layout",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
